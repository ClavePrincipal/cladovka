# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PUBLIC_URL=https://noir.example
PORT=8080
DATABASE_URL=   # for docker compose this is set automatically from DB_PASSWORD
PII_KEY=
LOOKUP_KEY=
METRICS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
KYC_WEBHOOK_SECRET=
TRUST_PROXY=true
COOKIE_SECURE=true
# Office/VPN IPs that may open the back office (comma-separated). Empty = anyone with a staff login + 2FA.
ADMIN_IP_ALLOWLIST=
# ISO-2 countries to block (needs a CDN that sets CF-IPCountry or similar)
BLOCKED_COUNTRIES=
PAYMENT_PROVIDERS=
CURRENCY=KZT
# KYC provider adapter name (leave empty until a provider is connected; 'sandbox' is for development only)
KYC_PROVIDER=
# Cloudflare Turnstile CAPTCHA (optional, both or neither)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Shown in the footer. Leave empty until you actually hold a licence.
LICENSE_TEXT=
# --- docker compose ---
DOMAIN=noir.example
DB_PASSWORD=
GRAFANA_PASSWORD=
