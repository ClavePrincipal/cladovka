# Скопируйте в .env и заполните:  cp .env.example .env

# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA...
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=123456789
# Username аккаунта поддержки, без @
SUPPORT_USERNAME=my_vpn_support
PROJECT_NAME=MyVPN
# Ссылка на оферту / условия (telegra.ph или сайт). Можно оставить пустым
OFFER_URL=
TIMEZONE=Europe/Moscow

# ===== Панель Remnawave =====
# Адрес панели (тот же, что открываете в браузере)
REMNAWAVE_URL=https://panel.example.com
# Панель → API Tokens → Create
REMNAWAVE_TOKEN=
# UUID сквадов (групп серверов) через запятую. Пусто = все сквады панели
REMNAWAVE_SQUAD_UUIDS=
# Если панель закрыта Caddy с X-Api-Key — укажите ключ
REMNAWAVE_CADDY_TOKEN=
# Сколько устройств можно подключить (0 = без ограничения).
# Работает, только если в панели включён HWID-лимит устройств
HWID_DEVICE_LIMIT=3
# Лимит трафика в ГБ в месяц (0 = безлимит)
TRAFFIC_LIMIT_GB=0

# ===== Тарифы =====
# дней:цена_в_рублях, через запятую
TARIFFS=30:199,90:549,180:999,360:1790
# Пробный период в днях (0 = выключить)
TRIAL_DAYS=3
# Бонус пригласившему, когда друг оплатит первую подписку (0 = выключить)
REFERRAL_BONUS_DAYS=7

# ===== Оплата: CryptoBot =====
# @CryptoBot → Crypto Pay → Create App → API Token
CRYPTOBOT_TOKEN=
# true — тестовая сеть (@CryptoTestnetBot), для проверки без реальных денег
CRYPTOBOT_TESTNET=false
CRYPTOBOT_ASSETS=USDT,TON,BTC

# ===== Оплата: ЮKassa (карты РФ, СБП) =====
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть клиента после оплаты — ссылка на вашего бота
YOOKASSA_RETURN_URL=https://t.me/your_vpn_bot
# Если в магазине включены чеки 54-ФЗ — email, на который они будут формироваться
YOOKASSA_RECEIPT_EMAIL=

# ===== Прочее =====
# Как часто проверять оплату (сек) и сколько живёт ссылка на оплату (мин)
PAYMENT_CHECK_INTERVAL=20
PAYMENT_TTL_MINUTES=60
# По умолчанию SQLite в docker-томе. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/vpn
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
